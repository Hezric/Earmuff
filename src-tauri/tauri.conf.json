{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Earmuff",
  "version": "0.1.0",
  "identifier": "com.hezric.earmuff",
  "build": {
    "beforeDevCommand": "vp run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vp run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "shortDescription": "A quiet guard for Windows listening levels.",
    "copyright": "Copyright (c) 2026 Hezric",
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
